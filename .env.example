# ApprovalFlow — environment variables
# Copy to .env and adjust. .env is git-ignored; never commit real secrets.
#
# These values are written into the Dapr local-file secret store by the
# secrets-loader container, and the services read them from there (M5) rather
# than from their own environment wherever a secret is involved.

# ============================================
# LLM provider (M15 — swappable by configuration, not by code)
# ============================================
# stub       — deterministic, offline, no key. Used by CI and the eval harness.
# openai     — https://api.openai.com/v1
# groq       — free tier, fast
# openrouter — free-tier models available
# together   — free tier available
# local      — Ollama / vLLM on the host (no key needed)
LLM_PROVIDER=stub
LLM_API_KEY=
# Leave blank to use the provider's default model.
LLM_MODEL=
# Leave blank to use the provider's default endpoint.
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.1

# How many policy clauses retrieval puts in front of the model, on top of the
# hard stops, which are always included (N5).
RAG_TOP_K=6

# ============================================
# AuthN/AuthZ (N1)
# ============================================
# Roles: submitter | approver | admin. Setting AUTH_ENABLED=false opens every
# endpoint including the policy-configuration API — local development only.
AUTH_ENABLED=true
JWT_SECRET=change-me-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ============================================
# PostgreSQL
# ============================================
POSTGRES_USER=approvalflow
POSTGRES_PASSWORD=approvalflow
POSTGRES_DB=approvalflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================
# RabbitMQ
# ============================================
RABBITMQ_USER=approvalflow
RABBITMQ_PASSWORD=approvalflow
RABBITMQ_ERLANG_COOKIE=secretcookie123

# ============================================
# Policy configuration (F7 / M13)
# ============================================
# How long a service may serve a cached copy of the policy before re-reading it
# from the state store. This is the delay between an admin PUT and the change
# taking effect everywhere.
POLICY_CONFIG_TTL_SECONDS=5

# ============================================
# Reliability (N3)
# ============================================
OUTBOX_POLL_INTERVAL=1.0
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=8

# ============================================
# Demo / verification
# ============================================
# Invoice numbers whose payment is forced to fail, to demonstrate the saga
# compensation journey (INV-1012 uses RS-90021).
PAYMENT_FAIL_INVOICE_NUMBERS=RS-90021
